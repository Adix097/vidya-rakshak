# MongoDB Atlas connection string for the production database.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Long, random secret used to sign JWTs. Do not reuse a development secret.
JWT_SECRET=replace-with-a-long-random-production-secret

# Public URL of the deployed ML service.
ML_SERVICE_URL=https://ml.vidyarakshak.in

# Render sets PORT automatically. Keep this value for local development only.
PORT=5000
